{
  "name": "flash-sale-reservation-engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready High-Concurrency Flash Sale & Ticket Reservation API showcasing Redis Lua atomic locking, PostgreSQL FOR UPDATE SKIP LOCKED, BullMQ delayed workers, and Idempotent Checkout",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/expiry.worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:concurrency": "tsx tests/concurrency.test.ts",
    "test:idempotency": "tsx tests/idempotency.test.ts",
    "test:unit": "tsx tests/unit.test.ts",
    "test": "npm run test:unit"
  },
  "keywords": [
    "high-concurrency",
    "flash-sale",
    "redis",
    "lua",
    "postgresql",
    "bullmq",
    "distributed-systems",
    "idempotency",
    "race-conditions"
  ],
  "author": "Staff Backend Engineer",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "bullmq": "^5.8.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
